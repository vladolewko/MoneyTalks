{
  "expo": {
    "name": "MoneyTalks",
    "slug": "moneytalks",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.moneytalks.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "app.moneytalks.mobile"
    },
    "scheme": "moneytalks",
    "plugins": [
      "expo-asset",
      "expo-router",
      "expo-notifications"
    ]
  }
}
